# Neon: DATABASE_URL is the pooled connection string, DIRECT_URL is the direct one (used for migrations).
# For a local Postgres, set both to the same value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/nurse_inventory?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/nurse_inventory?sslmode=require"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Required outside Vercel/Cloudflare Pages so Auth.js accepts the incoming Host header.
# Needed for localhost; in production set it only if you terminate your own proxy (e.g. nginx, a tunnel).
AUTH_TRUST_HOST="true"

# How many days back a NURSE may still record an entry. Admins have no limit. Default 3.
NURSE_BACKDATE_DAYS="3"

# Used only by `npm run db:seed` to create the first admin account.
SEED_ADMIN_NAME="Office Admin"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
